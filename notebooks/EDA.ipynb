   "source": [
    "import pandas as pd\n",
    "import plotly.express as px\n",
    "\n",
    "car_data = pd.read_csv('../vehicles_us.csv')\n",
    "\n",
    "fig = px.histogram(\n",
    "    car_data,\n",
    "    x='odometer',\n",
    "    \n",
    ")\n",
    "\n",
    "fig.show()\n",
    "\n",
    "fig = px.scatter(\n",
    "    car_data,\n",
    "    x='odometer',\n",
    "    y='price',\n",
    ")\n",
    "\n",
    "fig.show()\n",
    "\n"
   ]
  }
